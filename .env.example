# Copy to .env and set your values.

# --- Local Docker Compose ---
# Leave POSTGRES_HOST and KAFKA_HOST commented out.
# The compose files default to the 'postgres' and 'kafka' service names.
#POSTGRES_HOST=
#KAFKA_HOST=

# --- Remote server ---
# Uncomment and set the remote VM IP to connect to an external DB/Kafka.
#POSTGRES_HOST=<db-host>
#KAFKA_HOST=<db-host>

POSTGRES_PORT=5432
KAFKA_PORT=9092
POSTGRES_USER=pdms_user
POSTGRES_PASSWORD=pdms_password
