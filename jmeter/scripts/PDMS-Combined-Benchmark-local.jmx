          <stringProp name="script">// Extract PHONE from the previous Snapshot - Get by Person ID response
// This ensures we use the actual values from the snapshot, not CSV values
import groovy.json.JsonSlurper

// Get the last sample result (should be the Snapshot - Get by Person ID request)
def lastSample = ctx.getPreviousResult()
if (lastSample != null) {
    String responseData = lastSample.getResponseDataAsString()
    
    if (responseData != null &amp;&amp; !responseData.isEmpty()) {
        try {
            def json = new JsonSlurper().parseText(responseData)
            
            // The snapshot response may have contactIdentities directly or nested in personData
            def contactIdentities = json.identities
            if (contactIdentities == null &amp;&amp; json.personData != null) {
                contactIdentities = json.personData.identities
            }
            
            // Extract PHONE from contactIdentities array
            if (contactIdentities != null) {
                def phoneIdentity = contactIdentities.find { it.type == &quot;PHONE&quot; }
                if (phoneIdentity != null &amp;&amp; phoneIdentity.value != null) {
                    String phone = phoneIdentity.value.toString()
                    vars.put(&quot;PHONE&quot;, phone)
                    vars.put(&quot;PHONE_ENCODED&quot;, java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;))
                    log.info(&quot;Extracted PHONE from Snapshot before Get by Phone: &quot; + phone)
                } else {
                    log.warn(&quot;No PHONE found in Snapshot response&quot;)
                }
            } else {
                log.warn(&quot;No contactIdentities found in Snapshot response&quot;)
            }
        } catch (Exception e) {
            log.error(&quot;Error parsing Snapshot response before Get by Phone: &quot; + e.getMessage())
        }
    } else {
        log.warn(&quot;No response data available from Snapshot&quot;)
    }
} else {
    log.warn(&quot;No previous result found (Snapshot - Get by Person ID)&quot;)
