        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate CONSENT_ID for Withdraw/Delete" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String consentId = vars.get(&quot;CONSENT_ID&quot;)
if (consentId == null || consentId.isEmpty() || consentId.equals(&quot;&lt;EOF&gt;&quot;)) {
    log.warn(&quot;No CONSENT_ID found from create response, skipping withdraw/delete operations&quot;)
    vars.put(&quot;SKIP_CONSENT_OPS&quot;, &quot;true&quot;)
} else {
    log.debug(&quot;Using CONSENT_ID from created consent: &quot; + consentId)
    vars.put(&quot;SKIP_CONSENT_OPS&quot;, &quot;false&quot;)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
