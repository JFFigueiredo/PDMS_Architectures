<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PDMS - Combined Benchmark Test">
      <stringProp name="TestPlan.comments">Combined JMeter test plan for PDMS system benchmarking. Includes:
- Person Operations: Create, Read, Update, Delete
- Consents Operations: Create, List, Update, Withdraw, Delete  
- Snapshot Operations: Get by Person ID, Email, Phone
- Mixed Benchmark: Real-world scenario combining all operations

Individual test suites are disabled by default. Enable them for isolated testing.
The Mixed Benchmark Thread Group simulates realistic system load.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">http://127.0.0.1:8080</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="JWT_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">JWT_TOKEN</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PERSON_IDS_FILE" elementType="Argument">
            <stringProp name="Argument.name">PERSON_IDS_FILE</stringProp>
            <stringProp name="Argument.value">person_id_for_consents.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="IDENTITIES_FILE" elementType="Argument">
            <stringProp name="Argument.name">IDENTITIES_FILE</stringProp>
            <stringProp name="Argument.value">identities_person.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SCENARIO_NAME" elementType="Argument">
            <stringProp name="Argument.name">SCENARIO_NAME</stringProp>
            <stringProp name="Argument.value">mixed</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Extract Domain from BASE_URL">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">String baseUrl = props.get(&quot;base_url&quot;)
if (baseUrl == null || baseUrl.isEmpty()) {
    baseUrl = &quot;http://<app-host>&quot;
}
baseUrl = baseUrl.replaceAll(&quot;^https?://&quot;, &quot;&quot;)
String domain = baseUrl.split(&quot;:&quot;)[0]
vars.put(&quot;DOMAIN&quot;, domain)
log.info(&quot;Using domain: &quot; + domain)</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223PreProcessor>
      <hashTree/>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set Config - Person IDs" enabled="true">
