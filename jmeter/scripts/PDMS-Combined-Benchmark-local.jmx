          <stringProp name="script">String cid = vars.get(&quot;G2_CONSENT_ID&quot;)
if (cid == null || cid.isEmpty() || cid.equals(&quot;null&quot;)) {
    vars.put(&quot;G2_SKIP_WITHDRAW&quot;, &quot;true&quot;)
} else {
    vars.put(&quot;G2_SKIP_WITHDRAW&quot;, &quot;false&quot;)
}</stringProp>
