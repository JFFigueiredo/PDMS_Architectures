        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate CONSENT_ID for Withdraw" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String consentId = vars.get(&quot;CONSENT_ID&quot;)
if (consentId == null || consentId.isEmpty() || consentId.equals(&quot;&lt;EOF&gt;&quot;)) {
    log.warn(&quot;No consent found for withdraw, skipping WITHDRAW operation&quot;)
    vars.put(&quot;SKIP_WITHDRAW&quot;, &quot;true&quot;)
} else {
    vars.put(&quot;SKIP_WITHDRAW&quot;, &quot;false&quot;)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
