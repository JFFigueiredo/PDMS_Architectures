        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Extract Email from Snapshot Before Get by Email" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Extract EMAIL from the previous Snapshot - Get by Person ID response
// This ensures we use the actual values from the snapshot, not CSV values
import groovy.json.JsonSlurper

// Get the last sample result (should be the Snapshot - Get by Person ID request)
def lastSample = ctx.getPreviousResult()
if (lastSample != null) {
    String responseData = lastSample.getResponseDataAsString()
    
    if (responseData != null &amp;&amp; !responseData.isEmpty()) {
        try {
            def json = new JsonSlurper().parseText(responseData)
            
            // The snapshot response may have contactIdentities directly or nested in personData
            def contactIdentities = json.identities
            if (contactIdentities == null &amp;&amp; json.personData != null) {
                contactIdentities = json.personData.identities
            }
            
            // Extract EMAIL from contactIdentities array
            if (contactIdentities != null) {
                def emailIdentity = contactIdentities.find { it.type == &quot;EMAIL&quot; }
                if (emailIdentity != null &amp;&amp; emailIdentity.value != null) {
                    String email = emailIdentity.value.toString()
                    vars.put(&quot;EMAIL&quot;, email)
                    vars.put(&quot;EMAIL_ENCODED&quot;, java.net.URLEncoder.encode(email, &quot;UTF-8&quot;))
                    log.info(&quot;Extracted EMAIL from Snapshot before Get by Email: &quot; + email)
                } else {
                    log.warn(&quot;No EMAIL found in Snapshot response&quot;)
                }
            } else {
                log.warn(&quot;No contactIdentities found in Snapshot response&quot;)
            }
        } catch (Exception e) {
            log.error(&quot;Error parsing Snapshot response before Get by Email: &quot; + e.getMessage())
        }
    } else {
        log.warn(&quot;No response data available from Snapshot&quot;)
    }
} else {
    log.warn(&quot;No previous result found (Snapshot - Get by Person ID)&quot;)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
