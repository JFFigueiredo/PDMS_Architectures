        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="G2 - Validate Person ID from CSV" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String personId = vars.get(&quot;PERSON_ID&quot;)
if (personId == null || personId.isEmpty() || personId.equals(&quot;&lt;EOF&gt;&quot;)) {
    vars.put(&quot;PERSON_ID&quot;, &quot;00000000-0000-0000-0000-000000000000&quot;)
}
String[] types = [&quot;MARKETING&quot;,&quot;ANALYTICS&quot;,&quot;DATA_PROCESSING&quot;,&quot;COMMUNICATION&quot;,&quot;PROFILING&quot;]
vars.put(&quot;CONSENT_TYPE&quot;, types[new Random().nextInt(types.length)])</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
