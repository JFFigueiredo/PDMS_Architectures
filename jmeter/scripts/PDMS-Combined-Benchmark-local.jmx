        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="G3 - Validate and Encode Identities" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String personId = vars.get(&quot;PERSON_ID&quot;)
if (personId == null || personId.isEmpty() || personId.equals(&quot;&lt;EOF&gt;&quot;)) {
    vars.put(&quot;PERSON_ID&quot;, &quot;00000000-0000-0000-0000-000000000000&quot;)
}
String email = vars.get(&quot;EMAIL&quot;)
if (email == null || email.isEmpty() || email.equals(&quot;&lt;EOF&gt;&quot;)) {
    email = &quot;test@example.com&quot;
    vars.put(&quot;EMAIL&quot;, email)
}
String phone = vars.get(&quot;PHONE&quot;)
if (phone == null || phone.isEmpty() || phone.equals(&quot;&lt;EOF&gt;&quot;)) {
    phone = &quot;+351-910000000&quot;
    vars.put(&quot;PHONE&quot;, phone)
}
vars.put(&quot;EMAIL_ENCODED&quot;, java.net.URLEncoder.encode(email, &quot;UTF-8&quot;))
vars.put(&quot;PHONE_ENCODED&quot;, java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;))</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
