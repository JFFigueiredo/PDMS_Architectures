            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

// Get the response data from snapshot
String responseData = prev.getResponseDataAsString()

if (responseData != null &amp;&amp; !responseData.isEmpty()) {
    try {
        def json = new JsonSlurper().parseText(responseData)
        
        // The snapshot response may have contactIdentities directly or nested in personData
        def contactIdentities = json.contactIdentities
        if (contactIdentities == null &amp;&amp; json.personData != null) {
            contactIdentities = json.personData.contactIdentities
        }
        
        // Extract EMAIL from contactIdentities array
        if (contactIdentities != null) {
            def emailIdentity = contactIdentities.find { it.type == &quot;EMAIL&quot; }
            if (emailIdentity != null &amp;&amp; emailIdentity.value != null) {
                String email = emailIdentity.value.toString()
                vars.put(&quot;EMAIL&quot;, email)
                vars.put(&quot;EMAIL_ENCODED&quot;, java.net.URLEncoder.encode(email, &quot;UTF-8&quot;))
                log.info(&quot;Extracted EMAIL from Snapshot response: &quot; + email)
            }
            
            // Extract PHONE from contactIdentities array
            def phoneIdentity = contactIdentities.find { it.type == &quot;PHONE&quot; }
            if (phoneIdentity != null &amp;&amp; phoneIdentity.value != null) {
                String phone = phoneIdentity.value.toString()
                vars.put(&quot;PHONE&quot;, phone)
                vars.put(&quot;PHONE_ENCODED&quot;, java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;))
                log.info(&quot;Extracted PHONE from Snapshot response: &quot; + phone)
            }
        } else {
            log.warn(&quot;No contactIdentities found in Snapshot response&quot;)
        }
    } catch (Exception e) {
        log.error(&quot;Error parsing Snapshot JSON response: &quot; + e.getMessage())
    }
}</stringProp>
