      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="G1 - Generate Consent and Identity Data" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random
Random random = new Random()
String[] consentTypes = [&quot;MARKETING&quot;,&quot;ANALYTICS&quot;,&quot;DATA_PROCESSING&quot;,&quot;COMMUNICATION&quot;,&quot;PROFILING&quot;,&quot;LOCATION&quot;,&quot;BIOMETRIC&quot;,&quot;HEALTH_DATA&quot;,&quot;FINANCIAL&quot;,&quot;THIRD_PARTY_SHARING&quot;]
vars.put(&quot;CONSENT_TYPE&quot;, consentTypes[random.nextInt(consentTypes.length)])
long ts = System.currentTimeMillis()
int rnd = random.nextInt(90000) + 10000
vars.put(&quot;GEN_EMAIL&quot;, &quot;g1-&quot; + ctx.getThreadNum() + &quot;-&quot; + ts + &quot;-&quot; + rnd + &quot;@example.com&quot;)
vars.put(&quot;GEN_PHONE&quot;, &quot;+351-9&quot; + ctx.getThreadNum() + ts % 100000000)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="G1 - Create Person with Consent" enabled="true">
          <stringProp name="HTTPSampler.domain">${DOMAIN}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(person_port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/person</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
  &quot;userAccount&quot;: {&#xd;
    &quot;type&quot;: &quot;STANDARD&quot;,&#xd;
    &quot;firstName&quot;: &quot;GDPRTest&quot;,&#xd;
    &quot;lastName&quot;: &quot;User&quot;,&#xd;
    &quot;surname&quot;: &quot;G1&quot;,&#xd;
    &quot;password&quot;: &quot;TestPass123&quot;,&#xd;
    &quot;taxNumber&quot;: &quot;G1-${__threadNum}-${__time()}&quot;,&#xd;
    &quot;dateOfBirth&quot;: &quot;1990-01-15T00:00:00Z&quot;,&#xd;
    &quot;gender&quot;: &quot;MALE&quot;,&#xd;
    &quot;nationality&quot;: &quot;Portuguese&quot;&#xd;
  },&#xd;
  &quot;contactIdentities&quot;: [&#xd;
    { &quot;type&quot;: &quot;EMAIL&quot;, &quot;value&quot;: &quot;${GEN_EMAIL}&quot;, &quot;primary&quot;: true },&#xd;
    { &quot;type&quot;: &quot;PHONE&quot;, &quot;value&quot;: &quot;${GEN_PHONE}&quot;, &quot;primary&quot;: false }&#xd;
  ],&#xd;
  &quot;consents&quot;: [&#xd;
    {&#xd;
      &quot;consentType&quot;: &quot;${CONSENT_TYPE}&quot;,&#xd;
      &quot;granted&quot;: true,&#xd;
      &quot;grantedAt&quot;: &quot;2024-01-01T00:00:00Z&quot;,&#xd;
      &quot;consentMethod&quot;: &quot;WEB_FORM&quot;,&#xd;
      &quot;consentVersion&quot;: &quot;v1.0&quot;,&#xd;
      &quot;isActive&quot;: true&#xd;
    }&#xd;
  ]&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
