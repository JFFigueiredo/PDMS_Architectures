        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Random Consent Type for Create" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random

Random random = new Random()

// Random consent types (weighted distribution across 13 types)
String[] consentTypes = [&quot;MARKETING&quot;, &quot;MARKETING&quot;, &quot;MARKETING&quot;, &quot;MARKETING&quot;, &quot;MARKETING&quot;,
                        &quot;ANALYTICS&quot;, &quot;ANALYTICS&quot;, &quot;ANALYTICS&quot;,
                        &quot;DATA_PROCESSING&quot;, &quot;DATA_PROCESSING&quot;,
                        &quot;COMMUNICATION&quot;, &quot;COMMUNICATION&quot;,
                        &quot;PROFILING&quot;, &quot;PROFILING&quot;,
                        &quot;LOCATION&quot;,
                        &quot;BIOMETRIC&quot;,
                        &quot;HEALTH_DATA&quot;,
                        &quot;FINANCIAL&quot;,
                        &quot;SOCIAL_MEDIA&quot;,
                        &quot;THIRD_PARTY_SHARING&quot;,
                        &quot;RESEARCH&quot;,
                        &quot;AUTOMATED_DECISION_MAKING&quot;]
String consentType = consentTypes[random.nextInt(consentTypes.length)]
vars.put(&quot;CONSENT_TYPE&quot;, consentType)

log.debug(&quot;Generated random consent type: &quot; + consentType)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Email and Phone Variables for Mixed" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random

Random random = new Random()
int threadNum = ctx.getThreadNum()
long timestamp = System.currentTimeMillis()
int randomNum = random.nextInt(90000) + 10000
int randomPhoneNum = random.nextInt(9000) + 1000

// Generate unique email
String email = &quot;test-&quot; + threadNum + &quot;-&quot; + timestamp + &quot;-&quot; + randomNum + &quot;@example.com&quot;
vars.put(&quot;EMAIL&quot;, email)
vars.put(&quot;CREATED_EMAIL&quot;, email)  // Store in CREATED_EMAIL to avoid CSV overwrite
vars.put(&quot;EMAIL_ENCODED&quot;, java.net.URLEncoder.encode(email, &quot;UTF-8&quot;))

// Generate unique phone
String phone = &quot;+1-555-&quot; + threadNum + timestamp + randomPhoneNum
vars.put(&quot;PHONE&quot;, phone)
vars.put(&quot;CREATED_PHONE&quot;, phone)  // Store in CREATED_PHONE to avoid CSV overwrite
vars.put(&quot;PHONE_ENCODED&quot;, java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;))

log.debug(&quot;Generated EMAIL: &quot; + email + &quot; - Encoded: &quot; + vars.get(&quot;EMAIL_ENCODED&quot;))
log.debug(&quot;Generated PHONE: &quot; + phone + &quot; - Encoded: &quot; + vars.get(&quot;PHONE_ENCODED&quot;))</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
