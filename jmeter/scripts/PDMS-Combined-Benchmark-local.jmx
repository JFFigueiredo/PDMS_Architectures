        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Consent Data for Mixed" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random

Random random = new Random()

// Generate random consent data
String[] consentMethods = [&quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;MOBILE_APP&quot;, &quot;MOBILE_APP&quot;, &quot;EMAIL&quot;]
String consentMethod = consentMethods[random.nextInt(consentMethods.length)]
String[] consentVersions = [&quot;v1.0&quot;, &quot;v1.0&quot;, &quot;v1.1&quot;, &quot;v1.1&quot;, &quot;v2.0&quot;, &quot;v2.1&quot;]
String consentVersion = consentVersions[random.nextInt(consentVersions.length)]
boolean granted = random.nextDouble() &lt; 0.85

String consentJson = &quot;{\n&quot; +
    &quot;  \&quot;consentType\&quot;: \&quot;&quot; + vars.get(&quot;CONSENT_TYPE&quot;) + &quot;\&quot;,\n&quot; +
    &quot;  \&quot;granted\&quot;: &quot; + granted + &quot;,\n&quot; +
    &quot;  \&quot;consentMethod\&quot;: \&quot;&quot; + consentMethod + &quot;\&quot;,\n&quot; +
    &quot;  \&quot;consentVersion\&quot;: \&quot;&quot; + consentVersion + &quot;\&quot;\n&quot; +
    &quot;}&quot;
vars.put(&quot;CONSENT_JSON_PAYLOAD&quot;, consentJson)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
