        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate and URL Encode Email/Phone" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Validate and URL encode email
String email = vars.get(&quot;EMAIL&quot;)
if (email == null || email.isEmpty() || email.equals(&quot;&lt;EOF&gt;&quot;) || email.trim().isEmpty()) {
    vars.put(&quot;EMAIL_ENCODED&quot;, &quot;test%40example.com&quot;)
} else {
    vars.put(&quot;EMAIL_ENCODED&quot;, java.net.URLEncoder.encode(email, &quot;UTF-8&quot;))
}

// Validate and URL encode phone
String phone = vars.get(&quot;PHONE&quot;)
if (phone == null || phone.isEmpty() || phone.equals(&quot;&lt;EOF&gt;&quot;) || phone.trim().isEmpty()) {
    vars.put(&quot;PHONE_ENCODED&quot;, &quot;%2B1-555-0000&quot;)
} else {
    vars.put(&quot;PHONE_ENCODED&quot;, java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;))
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
