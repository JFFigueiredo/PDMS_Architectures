      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate and URL Encode Phone" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Validate and URL encode phone
String phone = vars.get(&quot;PHONE&quot;)
if (phone == null || phone.isEmpty() || phone.equals(&quot;&lt;EOF&gt;&quot;) || phone.trim().isEmpty()) {
    log.warn(&quot;PHONE is empty, using placeholder&quot;)
    vars.put(&quot;PHONE&quot;, &quot;+1-555-0000&quot;)
    vars.put(&quot;PHONE_ENCODED&quot;, &quot;%2B1-555-0000&quot;)
} else {
    // URL encode the phone
    String encodedPhone = java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;)
    vars.put(&quot;PHONE_ENCODED&quot;, encodedPhone)
    log.debug(&quot;Phone: &quot; + phone + &quot; - Encoded: &quot; + encodedPhone)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
