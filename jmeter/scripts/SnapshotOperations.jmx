          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Validate and URL encode email
String email = vars.get(&quot;EMAIL&quot;)
if (email == null || email.isEmpty() || email.equals(&quot;&lt;EOF&gt;&quot;) || email.trim().isEmpty()) {
    log.warn(&quot;EMAIL is empty, using placeholder&quot;)
    vars.put(&quot;EMAIL&quot;, &quot;test@example.com&quot;)
    vars.put(&quot;EMAIL_ENCODED&quot;, &quot;test%40example.com&quot;)
} else {
    // URL encode the email
    String encodedEmail = java.net.URLEncoder.encode(email, &quot;UTF-8&quot;)
    vars.put(&quot;EMAIL_ENCODED&quot;, encodedEmail)
    log.debug(&quot;Email: &quot; + email + &quot; - Encoded: &quot; + encodedEmail)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
