        <!-- ── Pre-withdraw: validate IDs and generate reason ─────── -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate Consent IDs for Withdraw" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String a = vars.get(&quot;CONSENT_ID_A&quot;)
String b = vars.get(&quot;CONSENT_ID_B&quot;)
String c = vars.get(&quot;CONSENT_ID_C&quot;)
boolean aOk = a != null &amp;&amp; !a.isEmpty() &amp;&amp; !a.equals(&quot;&lt;EOF&gt;&quot;)
boolean bOk = b != null &amp;&amp; !b.isEmpty() &amp;&amp; !b.equals(&quot;&lt;EOF&gt;&quot;)
boolean cOk = c != null &amp;&amp; !c.isEmpty() &amp;&amp; !c.equals(&quot;&lt;EOF&gt;&quot;)
vars.put(&quot;SKIP_WITHDRAW_A&quot;, aOk ? &quot;false&quot; : &quot;true&quot;)
vars.put(&quot;SKIP_WITHDRAW_B&quot;, bOk ? &quot;false&quot; : &quot;true&quot;)
vars.put(&quot;SKIP_WITHDRAW_C&quot;, cOk ? &quot;false&quot; : &quot;true&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Withdrawal Reason" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random
Random random = new Random()
String[] reasons = [&quot;User requested withdrawal&quot;, &quot;Privacy concerns&quot;, &quot;No longer needed&quot;, &quot;Service termination&quot;, &quot;Policy change&quot;]
String reason = reasons[random.nextInt(reasons.length)]
vars.put(&quot;WITHDRAW_REASON_JSON&quot;, &quot;{\n  \&quot;withdrawalReason\&quot;: \&quot;&quot; + reason + &quot;\&quot;\n}&quot;)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
