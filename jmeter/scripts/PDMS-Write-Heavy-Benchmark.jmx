<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PDMS - Write-Heavy Benchmark (80% Writes / 20% Reads)">
      <stringProp name="TestPlan.comments">Write-heavy benchmark for PDMS architectural comparison.
Ratio: 8 writes + 2 reads = 80% / 20% per iteration.
Write sequence: Person Create, Person Update, Consent Create x3 (distinct types), Consent Withdraw x3.
Read sequence: Person Get, Consents List.
Use to stress write paths (DB inserts, audit trail generation, Kafka publish) across all 4 variants.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">http://<app-host>:8080</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="JWT_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">JWT_TOKEN</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SCENARIO_NAME" elementType="Argument">
            <stringProp name="Argument.name">SCENARIO_NAME</stringProp>
            <stringProp name="Argument.value">write-heavy</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ═══════════════════════════════════════════════════════════
           WRITE-HEAVY BENCHMARK THREAD GROUP
           80% writes (8 ops): Person Create/Update, Consent Create x3, Consent Withdraw x3
           20% reads  (2 ops): Person Get, Consents List
           ═══════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Write-Heavy Benchmark - 80% Writes / 20% Reads" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,30)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,300)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- ── Pre-iteration setup ────────────────────────────────── -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Email and Phone Variables" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random
// Only generate email/phone once per iteration - check if already set
String lastIterationKey = vars.get(&quot;_ITERATION_MARKER&quot;)
int iterationCount = (lastIterationKey == null) ? 0 : Integer.parseInt(lastIterationKey)
int currentCount = ctx.getVariables().getIteration()

if (lastIterationKey == null || currentCount != iterationCount) {
    Random random = new Random()
    int threadNum = ctx.getThreadNum()
    int iterNum = currentCount
    int rndNum = random.nextInt(90000) + 10000
    int rndPhone = random.nextInt(9000) + 1000

    String email = &quot;wh-&quot; + threadNum + &quot;-&quot; + iterNum + &quot;-&quot; + rndNum + &quot;@example.com&quot;
    vars.put(&quot;EMAIL&quot;, email)
    vars.put(&quot;EMAIL_ENCODED&quot;, java.net.URLEncoder.encode(email, &quot;UTF-8&quot;))

    String phone = &quot;+1-777-&quot; + threadNum + iterNum + rndPhone
    vars.put(&quot;PHONE&quot;, phone)
    vars.put(&quot;PHONE_ENCODED&quot;, java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;))

    vars.put(&quot;_ITERATION_MARKER&quot;, String.valueOf(currentCount))
    log.info(&quot;Generated NEW email/phone for iteration &quot; + currentCount + &quot;: &quot; + email)
} else {
    log.info(&quot;Reusing email/phone from iteration &quot; + currentCount + &quot;: &quot; + vars.get(&quot;EMAIL&quot;))
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Three Distinct Consent Types" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random
Random random = new Random()
// Three separate buckets so the three consent types are always distinct
String[] bucketA = [&quot;MARKETING&quot;, &quot;ANALYTICS&quot;, &quot;DATA_PROCESSING&quot;]
String[] bucketB = [&quot;COMMUNICATION&quot;, &quot;PROFILING&quot;, &quot;LOCATION&quot;]
String[] bucketC = [&quot;HEALTH_DATA&quot;, &quot;FINANCIAL&quot;, &quot;RESEARCH&quot;]
String[] methods  = [&quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;MOBILE_APP&quot;, &quot;EMAIL&quot;]
String[] versions = [&quot;v1.0&quot;, &quot;v1.0&quot;, &quot;v1.1&quot;, &quot;v2.0&quot;]
vars.put(&quot;CONSENT_TYPE_A&quot;, bucketA[random.nextInt(bucketA.length)])
vars.put(&quot;CONSENT_TYPE_B&quot;, bucketB[random.nextInt(bucketB.length)])
vars.put(&quot;CONSENT_TYPE_C&quot;, bucketC[random.nextInt(bucketC.length)])
vars.put(&quot;CONSENT_METHOD&quot;, methods[random.nextInt(methods.length)])
vars.put(&quot;CONSENT_VERSION&quot;, versions[random.nextInt(versions.length)])</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Extract Domain from BASE_URL" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String baseUrl = props.get(&quot;base_url&quot;)
if (baseUrl == null || baseUrl.isEmpty()) {
    baseUrl = &quot;http://<app-host>&quot;
}
baseUrl = baseUrl.replaceAll(&quot;^https?://&quot;, &quot;&quot;)
String domain = baseUrl.split(&quot;:&quot;)[0]
vars.put(&quot;DOMAIN&quot;, domain)
log.info(&quot;Using domain: &quot; + domain)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <!-- ── WRITE 1 of 8: Person Create ───────────────────────── -->
