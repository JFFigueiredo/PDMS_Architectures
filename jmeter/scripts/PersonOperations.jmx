  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PDMS - Person CRUD Complete">
      <stringProp name="TestPlan.comments">Complete JMeter test plan for Person CRUD operations: Create, Read, Update, Delete</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">http://<app-host>:8080</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="JWT_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">JWT_TOKEN</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Create Person" enabled="false">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">2</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Random Consent Type">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random

Random random = new Random()

// Random consent types (weighted distribution across 13 types)
String[] consentTypes = [&quot;MARKETING&quot;, &quot;MARKETING&quot;, &quot;MARKETING&quot;, &quot;MARKETING&quot;, &quot;MARKETING&quot;,
                        &quot;ANALYTICS&quot;, &quot;ANALYTICS&quot;, &quot;ANALYTICS&quot;,
                        &quot;DATA_PROCESSING&quot;, &quot;DATA_PROCESSING&quot;,
                        &quot;COMMUNICATION&quot;, &quot;COMMUNICATION&quot;,
                        &quot;PROFILING&quot;, &quot;PROFILING&quot;,
                        &quot;LOCATION&quot;,
                        &quot;BIOMETRIC&quot;,
                        &quot;HEALTH_DATA&quot;,
                        &quot;FINANCIAL&quot;,
                        &quot;SOCIAL_MEDIA&quot;,
                        &quot;THIRD_PARTY_SHARING&quot;,
                        &quot;RESEARCH&quot;,
                        &quot;AUTOMATED_DECISION_MAKING&quot;]
String consentType = consentTypes[random.nextInt(consentTypes.length)]
vars.put(&quot;CONSENT_TYPE&quot;, consentType)

log.debug(&quot;Generated random consent type: &quot; + consentType)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="1. Create Person">
          <stringProp name="HTTPSampler.domain"><app-host></stringProp>
          <stringProp name="HTTPSampler.port">8080</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/person</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
  &quot;userAccount&quot;: {&#xd;
    &quot;type&quot;: &quot;STANDARD&quot;,&#xd;
    &quot;firstName&quot;: &quot;John&quot;,&#xd;
    &quot;lastName&quot;: &quot;Doe&quot;,&#xd;
    &quot;surname&quot;: &quot;Smith&quot;,&#xd;
    &quot;password&quot;: &quot;SecurePass123&quot;,&#xd;
    &quot;taxNumber&quot;: &quot;123456789&quot;,&#xd;
    &quot;dateOfBirth&quot;: &quot;1990-01-15T00:00:00Z&quot;,&#xd;
    &quot;gender&quot;: &quot;MALE&quot;,&#xd;
    &quot;nationality&quot;: &quot;American&quot;&#xd;
  },&#xd;
  &quot;contactIdentities&quot;: [&#xd;
    {&#xd;
      &quot;type&quot;: &quot;EMAIL&quot;,&#xd;
      &quot;value&quot;: &quot;test-${__threadNum}-${__time()}-${__Random(10000,99999)}@example.com&quot;,&#xd;
      &quot;primary&quot;: true&#xd;
    },&#xd;
    {&#xd;
      &quot;type&quot;: &quot;PHONE&quot;,&#xd;
      &quot;value&quot;: &quot;+1-555-${__threadNum}${__time(,)}${__Random(1000,9999)}&quot;,&#xd;
      &quot;primary&quot;: false&#xd;
    }&#xd;
  ],&#xd;
  &quot;addresses&quot;: [&#xd;
    {&#xd;
      &quot;addressType&quot;: &quot;HOME&quot;,&#xd;
      &quot;country&quot;: &quot;United States&quot;,&#xd;
      &quot;postalCode&quot;: &quot;12345&quot;,&#xd;
      &quot;city&quot;: &quot;New York&quot;,&#xd;
      &quot;street&quot;: &quot;Main Street&quot;,&#xd;
      &quot;streetNumber&quot;: &quot;123&quot;,&#xd;
      &quot;isPrimary&quot;: true,&#xd;
      &quot;verifiedAddress&quot;: true&#xd;
    }&#xd;
  ],&#xd;
  &quot;consents&quot;: [&#xd;
    {&#xd;
      &quot;consentType&quot;: &quot;${CONSENT_TYPE}&quot;,&#xd;
      &quot;granted&quot;: true,&#xd;
      &quot;grantedAt&quot;: &quot;2024-01-01T00:00:00Z&quot;,&#xd;
      &quot;consentMethod&quot;: &quot;WEB_FORM&quot;,&#xd;
      &quot;consentVersion&quot;: &quot;v1.0&quot;,&#xd;
      &quot;isActive&quot;: true&#xd;
    }&#xd;
  ],&#xd;
  &quot;preferences&quot;: {&#xd;
    &quot;language&quot;: &quot;en&quot;,&#xd;
    &quot;nickname&quot;: &quot;Johnny&quot;&#xd;
  }&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
