        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate PERSON_ID" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Validate that PERSON_ID is set
String personId = vars.get(&quot;PERSON_ID&quot;)
String personIdRaw = personId != null ? personId : &quot;null&quot;

// Check for empty, null, or EOF
if (personId == null || personId.isEmpty() || personId.equals(&quot;&lt;EOF&gt;&quot;) || personId.trim().isEmpty()) {
    log.error(&quot;=== PERSON_ID VALIDATION FAILED ===&quot;)
    log.error(&quot;PERSON_ID value: &quot; + personIdRaw)
    log.error(&quot;CSV file variable: &quot; + vars.get(&quot;PERSON_IDS_FILE&quot;))
    log.error(&quot;Working directory: &quot; + System.getProperty(&quot;user.dir&quot;))
    
    // Check if file exists
    String fileName = vars.get(&quot;PERSON_IDS_FILE&quot;)
    if (fileName != null) {
        java.io.File file = new java.io.File(fileName)
        log.error(&quot;Checking file: &quot; + file.getAbsolutePath())
        log.error(&quot;File exists: &quot; + file.exists())
        if (file.exists()) {
            log.error(&quot;File size: &quot; + file.length() + &quot; bytes&quot;)
            log.error(&quot;File readable: &quot; + file.canRead())
            
            // Try to read first line
            try {
                java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.FileReader(file))
                String firstLine = reader.readLine()
                reader.close()
                if (firstLine != null) {
                    log.error(&quot;First line in file: &quot; + firstLine)
                } else {
                    log.error(&quot;File is empty (no lines)&quot;)
                }
            } catch (Exception e) {
                log.error(&quot;Error reading file: &quot; + e.getMessage())
            }
        } else {
            // Try absolute path from working directory
            String workingDir = System.getProperty(&quot;user.dir&quot;)
            java.io.File absFile = new java.io.File(workingDir, fileName)
            log.error(&quot;Trying absolute path: &quot; + absFile.getAbsolutePath())
            log.error(&quot;Absolute file exists: &quot; + absFile.exists())
        }
    }
    
    // Set a placeholder to prevent URI syntax error
    vars.put(&quot;PERSON_ID&quot;, &quot;00000000-0000-0000-0000-000000000000&quot;)
    log.warn(&quot;Using placeholder UUID to prevent test failure&quot;)
    log.error(&quot;=== END PERSON_ID VALIDATION ===&quot;)
} else {
    log.debug(&quot;PERSON_ID is valid: &quot; + personId)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Random Consent Data" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.time.Instant
import java.time.temporal.ChronoUnit
import java.util.Random

Random random = new Random()

// Random consent types (weighted distribution across 13 types)
String[] consentTypes = [&quot;MARKETING&quot;, 
                        &quot;DATA_PROCESSING&quot;, &quot;DATA_PROCESSING&quot;,
                        &quot;COMMUNICATION&quot;, &quot;COMMUNICATION&quot;,
                        &quot;PROFILING&quot;, &quot;PROFILING&quot;,
                        &quot;LOCATION&quot;,
                        &quot;BIOMETRIC&quot;,
                        &quot;HEALTH_DATA&quot;,
                        &quot;FINANCIAL&quot;,
                        &quot;SOCIAL_MEDIA&quot;,
                        &quot;THIRD_PARTY_SHARING&quot;,
                        &quot;RESEARCH&quot;,
                        &quot;AUTOMATED_DECISION_MAKING&quot;]
String consentType = consentTypes[random.nextInt(consentTypes.length)]
vars.put(&quot;CONSENT_TYPE&quot;, consentType)

// Random consent methods (weighted: WEB_FORM 60%, MOBILE_APP 30%, EMAIL 10%)
String[] consentMethods = [&quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;,
                          &quot;MOBILE_APP&quot;, &quot;MOBILE_APP&quot;, &quot;MOBILE_APP&quot;,
                          &quot;EMAIL&quot;]
String consentMethod = consentMethods[random.nextInt(consentMethods.length)]
vars.put(&quot;CONSENT_METHOD&quot;, consentMethod)

// Random consent versions (v1.0 40%, v1.1 30%, v2.0 20%, v2.1 10%)
String[] consentVersions = [&quot;v1.0&quot;, &quot;v1.0&quot;, &quot;v1.0&quot;, &quot;v1.0&quot;,
                           &quot;v1.1&quot;, &quot;v1.1&quot;, &quot;v1.1&quot;,
                           &quot;v2.0&quot;, &quot;v2.0&quot;,
                           &quot;v2.1&quot;]
String consentVersion = consentVersions[random.nextInt(consentVersions.length)]
vars.put(&quot;CONSENT_VERSION&quot;, consentVersion)

// Random granted status (85% granted, 15% not granted - realistic distribution)
boolean granted = random.nextDouble() &lt; 0.85
vars.put(&quot;CONSENT_GRANTED&quot;, String.valueOf(granted))

// Random expiration date (70% have expiration, 30% don&apos;t)
String expiresAtJson = &quot;&quot;
if (random.nextDouble() &lt; 0.70) {
    // Random expiration between 30 days and 2 years from now
    int daysToAdd = 30 + random.nextInt(730 - 30) // 30 to 730 days
    Instant expiration = Instant.now().plus(daysToAdd, ChronoUnit.DAYS)
    expiresAtJson = &quot;,\n  \&quot;expiresAt\&quot;: \&quot;&quot; + expiration.toString() + &quot;\&quot;&quot;
}

// Build complete JSON payload
String jsonPayload = &quot;{\n&quot; +
    &quot;  \&quot;consentType\&quot;: \&quot;&quot; + consentType + &quot;\&quot;,\n&quot; +
    &quot;  \&quot;granted\&quot;: &quot; + granted + expiresAtJson + &quot;,\n&quot; +
    &quot;  \&quot;consentMethod\&quot;: \&quot;&quot; + consentMethod + &quot;\&quot;,\n&quot; +
    &quot;  \&quot;consentVersion\&quot;: \&quot;&quot; + consentVersion + &quot;\&quot;\n&quot; +
    &quot;}&quot;

vars.put(&quot;CONSENT_JSON_PAYLOAD&quot;, jsonPayload)

log.debug(&quot;Generated consent - Type: &quot; + consentType + &quot;, Method: &quot; + consentMethod + &quot;, Version: &quot; + consentVersion + &quot;, Granted: &quot; + granted)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
