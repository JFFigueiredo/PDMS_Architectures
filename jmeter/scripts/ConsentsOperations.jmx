          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Withdrawal Reason" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Random

Random random = new Random()
String[] withdrawalReasons = [
    &quot;User requested withdrawal&quot;,
    &quot;Privacy concerns&quot;,
    &quot;No longer needed&quot;,
    &quot;Service termination&quot;,
    &quot;Policy change&quot;
]
String withdrawalReason = withdrawalReasons[random.nextInt(withdrawalReasons.length)]
vars.put(&quot;WITHDRAWAL_REASON&quot;, withdrawalReason)

String jsonPayload = &quot;{\n  \&quot;withdrawalReason\&quot;: \&quot;&quot; + withdrawalReason + &quot;\&quot;\n}&quot;
vars.put(&quot;WITHDRAW_JSON_PAYLOAD&quot;, jsonPayload)</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
