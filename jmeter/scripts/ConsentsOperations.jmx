        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate PERSON_ID" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Validate that PERSON_ID is set
String personId = vars.get(&quot;PERSON_ID&quot;)
String personIdRaw = personId != null ? personId : &quot;null&quot;

// Check for empty, null, or EOF
if (personId == null || personId.isEmpty() || personId.equals(&quot;&lt;EOF&gt;&quot;) || personId.trim().isEmpty()) {
    log.error(&quot;=== PERSON_ID VALIDATION FAILED ===&quot;)
    log.error(&quot;PERSON_ID value: &quot; + personIdRaw)
    log.error(&quot;CSV file variable: &quot; + vars.get(&quot;PERSON_IDS_FILE&quot;))
    log.error(&quot;Working directory: &quot; + System.getProperty(&quot;user.dir&quot;))
    
    // Check if file exists
    String fileName = vars.get(&quot;PERSON_IDS_FILE&quot;)
    if (fileName != null) {
        java.io.File file = new java.io.File(fileName)
        log.error(&quot;Checking file: &quot; + file.getAbsolutePath())
        log.error(&quot;File exists: &quot; + file.exists())
        if (file.exists()) {
            log.error(&quot;File size: &quot; + file.length() + &quot; bytes&quot;)
            log.error(&quot;File readable: &quot; + file.canRead())
            
            // Try to read first line
            try {
                java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.FileReader(file))
                String firstLine = reader.readLine()
                reader.close()
                if (firstLine != null) {
                    log.error(&quot;First line in file: &quot; + firstLine)
                } else {
                    log.error(&quot;File is empty (no lines)&quot;)
                }
            } catch (Exception e) {
                log.error(&quot;Error reading file: &quot; + e.getMessage())
            }
        } else {
            // Try absolute path from working directory
            String workingDir = System.getProperty(&quot;user.dir&quot;)
            java.io.File absFile = new java.io.File(workingDir, fileName)
            log.error(&quot;Trying absolute path: &quot; + absFile.getAbsolutePath())
            log.error(&quot;Absolute file exists: &quot; + absFile.exists())
        }
    }
    
    // Set a placeholder to prevent URI syntax error
    vars.put(&quot;PERSON_ID&quot;, &quot;00000000-0000-0000-0000-000000000000&quot;)
    log.warn(&quot;Using placeholder UUID to prevent test failure&quot;)
    log.error(&quot;=== END PERSON_ID VALIDATION ===&quot;)
} else {
    log.debug(&quot;PERSON_ID is valid: &quot; + personId)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
