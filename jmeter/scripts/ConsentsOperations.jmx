        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Controller - POST (20%)" enabled="true">
          <stringProp name="IfController.condition">${__groovy(vars.get(&quot;OPERATION&quot;) == &quot;POST&quot;)}</stringProp>
