          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.time.Instant
import java.time.temporal.ChronoUnit
import java.util.Random

Random random = new Random()

// Random consent types (weighted distribution across 13 types)
String[] consentTypes = [&quot;MARKETING&quot;, 
                        &quot;DATA_PROCESSING&quot;, &quot;DATA_PROCESSING&quot;,
                        &quot;COMMUNICATION&quot;, &quot;COMMUNICATION&quot;,
                        &quot;PROFILING&quot;, &quot;PROFILING&quot;,
                        &quot;LOCATION&quot;,
                        &quot;BIOMETRIC&quot;,
                        &quot;HEALTH_DATA&quot;,
                        &quot;FINANCIAL&quot;,
                        &quot;SOCIAL_MEDIA&quot;,
                        &quot;THIRD_PARTY_SHARING&quot;,
                        &quot;RESEARCH&quot;,
                        &quot;AUTOMATED_DECISION_MAKING&quot;]
String consentType = consentTypes[random.nextInt(consentTypes.length)]
vars.put(&quot;CONSENT_TYPE&quot;, consentType)

String[] consentMethods = [&quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;,
                          &quot;MOBILE_APP&quot;, &quot;MOBILE_APP&quot;, &quot;MOBILE_APP&quot;,
                          &quot;EMAIL&quot;]
String consentMethod = consentMethods[random.nextInt(consentMethods.length)]
vars.put(&quot;CONSENT_METHOD&quot;, consentMethod)

String[] consentVersions = [&quot;v1.0&quot;, &quot;v1.0&quot;, &quot;v1.0&quot;, &quot;v1.0&quot;,
                           &quot;v1.1&quot;, &quot;v1.1&quot;, &quot;v1.1&quot;,
                           &quot;v2.0&quot;, &quot;v2.0&quot;,
                           &quot;v2.1&quot;]
String consentVersion = consentVersions[random.nextInt(consentVersions.length)]
vars.put(&quot;CONSENT_VERSION&quot;, consentVersion)

boolean granted = random.nextDouble() &lt; 0.85
vars.put(&quot;CONSENT_GRANTED&quot;, String.valueOf(granted))

String expiresAtJson = &quot;&quot;
if (random.nextDouble() &lt; 0.70) {
    int daysToAdd = 30 + random.nextInt(730 - 30)
    Instant expiration = Instant.now().plus(daysToAdd, ChronoUnit.DAYS)
    expiresAtJson = &quot;,\n  \&quot;expiresAt\&quot;: \&quot;&quot; + expiration.toString() + &quot;\&quot;&quot;
}

String jsonPayload = &quot;{\n&quot; +
    &quot;  \&quot;consentType\&quot;: \&quot;&quot; + consentType + &quot;\&quot;,\n&quot; +
    &quot;  \&quot;granted\&quot;: &quot; + granted + expiresAtJson + &quot;,\n&quot; +
    &quot;  \&quot;consentMethod\&quot;: \&quot;&quot; + consentMethod + &quot;\&quot;,\n&quot; +
    &quot;  \&quot;consentVersion\&quot;: \&quot;&quot; + consentVersion + &quot;\&quot;\n&quot; +
    &quot;}&quot;
vars.put(&quot;CONSENT_JSON_PAYLOAD&quot;, jsonPayload)</stringProp>
