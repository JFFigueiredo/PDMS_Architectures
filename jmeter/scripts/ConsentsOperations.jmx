            <stringProp name="script">String consentId = vars.get(&quot;CONSENT_ID&quot;)
if (consentId == null || consentId.isEmpty() || consentId.equals(&quot;&lt;EOF&gt;&quot;)) {
    log.warn(&quot;No consent found for delete, skipping DELETE operation&quot;)
    vars.put(&quot;SKIP_DELETE&quot;, &quot;true&quot;)
} else {
    vars.put(&quot;SKIP_DELETE&quot;, &quot;false&quot;)
}</stringProp>
