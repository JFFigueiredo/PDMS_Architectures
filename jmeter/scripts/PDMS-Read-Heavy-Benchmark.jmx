        <!-- ── READ 6 of 8: Person Get (repeat) ──────────────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Person - Get (repeat)" enabled="true">
          <stringProp name="HTTPSampler.domain">${DOMAIN}</stringProp>
