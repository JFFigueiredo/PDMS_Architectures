<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PDMS - Read-Heavy Benchmark (80% Reads / 20% Writes)">
      <stringProp name="TestPlan.comments">Read-heavy benchmark for PDMS architectural comparison.
Ratio: 2 writes + 8 reads = 20% / 80% per iteration.
Write sequence (self-seeding): Person Create, Consent Create — guarantees reads always operate on existing data.
Read sequence: Person Get, Consents List, Snapshot Get by Person ID, Snapshot Get by Email, Snapshot Get by Phone,
               Person Get (repeat), Consents List (repeat), Snapshot Get by Person ID (repeat).
Use to stress read paths (query model, snapshot assembly, audit trail reads) across all 4 variants.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">http://<app-host>:8080</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="JWT_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">JWT_TOKEN</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SCENARIO_NAME" elementType="Argument">
            <stringProp name="Argument.name">SCENARIO_NAME</stringProp>
            <stringProp name="Argument.value">read-heavy</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ═══════════════════════════════════════════════════════════
           READ-HEAVY BENCHMARK THREAD GROUP
           20% writes (2 ops): Person Create, Consent Create  — self-seeding
           80% reads  (8 ops): Person Get x2, Consents List x2, Snapshot by ID x2, by Email, by Phone
           ═══════════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Read-Heavy Benchmark - 80% Reads / 20% Writes" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(threads,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp,30)}</stringProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,300)}</stringProp>
        <longProp name="ThreadGroup.delay">0</longProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <intProp name="LoopController.loops">-1</intProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- ── Pre-iteration setup ────────────────────────────────── -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Email and Phone Variables" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random
// Only generate email/phone once per iteration - check if already set
String lastIterationKey = vars.get(&quot;_ITERATION_MARKER&quot;)
int iterationCount = (lastIterationKey == null) ? 0 : Integer.parseInt(lastIterationKey)
int currentCount = ctx.getVariables().getIteration()

if (lastIterationKey == null || currentCount != iterationCount) {
    Random random = new Random()
    int threadNum = ctx.getThreadNum()
    int iterNum = currentCount
    int rndNum = random.nextInt(90000) + 10000
    int rndPhone = random.nextInt(9000) + 1000

    String email = &quot;rh-&quot; + threadNum + &quot;-&quot; + iterNum + &quot;-&quot; + rndNum + &quot;@example.com&quot;
    vars.put(&quot;EMAIL&quot;, email)
    vars.put(&quot;EMAIL_ENCODED&quot;, java.net.URLEncoder.encode(email, &quot;UTF-8&quot;))

    String phone = &quot;+1-888-&quot; + threadNum + iterNum + rndPhone
    vars.put(&quot;PHONE&quot;, phone)
    vars.put(&quot;PHONE_ENCODED&quot;, java.net.URLEncoder.encode(phone, &quot;UTF-8&quot;))

    vars.put(&quot;_ITERATION_MARKER&quot;, String.valueOf(currentCount))
    log.info(&quot;Generated NEW email/phone for iteration &quot; + currentCount + &quot;: &quot; + email)
} else {
    log.info(&quot;Reusing email/phone from iteration &quot; + currentCount + &quot;: &quot; + vars.get(&quot;EMAIL&quot;))
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Consent Data" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random
Random random = new Random()
String[] consentTypes = [&quot;MARKETING&quot;, &quot;ANALYTICS&quot;, &quot;DATA_PROCESSING&quot;, &quot;COMMUNICATION&quot;,
                         &quot;PROFILING&quot;, &quot;LOCATION&quot;, &quot;HEALTH_DATA&quot;, &quot;FINANCIAL&quot;, &quot;RESEARCH&quot;]
String[] methods  = [&quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;WEB_FORM&quot;, &quot;MOBILE_APP&quot;, &quot;EMAIL&quot;]
String[] versions = [&quot;v1.0&quot;, &quot;v1.0&quot;, &quot;v1.1&quot;, &quot;v2.0&quot;]
vars.put(&quot;CONSENT_TYPE&quot;, consentTypes[random.nextInt(consentTypes.length)])
vars.put(&quot;CONSENT_METHOD&quot;, methods[random.nextInt(methods.length)])
vars.put(&quot;CONSENT_VERSION&quot;, versions[random.nextInt(versions.length)])</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Extract Domain from BASE_URL" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">String baseUrl = props.get(&quot;base_url&quot;)
if (baseUrl == null || baseUrl.isEmpty()) {
    baseUrl = &quot;http://<app-host>&quot;
}
baseUrl = baseUrl.replaceAll(&quot;^https?://&quot;, &quot;&quot;)
String domain = baseUrl.split(&quot;:&quot;)[0]
vars.put(&quot;DOMAIN&quot;, domain)
log.info(&quot;Using domain: &quot; + domain)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <!-- ── WRITE 1 of 2: Person Create (self-seed) ───────────── -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Person - Create" enabled="true">
          <stringProp name="HTTPSampler.domain">${DOMAIN}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(person_port,8080)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/person</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{
  "status": "ACTIVE",
  "userAccount": {
    "type": "STANDARD",
    "firstName": "Read",
    "lastName": "Heavy",
    "surname": "Test",
    "password": "SecurePass123",
    "taxNumber": "123456789",
    "dateOfBirth": "1990-01-15T00:00:00Z",
    "gender": "MALE",
    "nationality": "American"
  },
  "contactIdentities": [
    {"type": "EMAIL", "value": "${EMAIL}", "primary": true},
    {"type": "PHONE", "value": "${PHONE}", "primary": false}
  ],
  "addresses": [
    {
      "addressType": "HOME",
      "country": "United States",
      "postalCode": "12345",
      "city": "New York",
      "street": "Main Street",
      "streetNumber": "123",
      "isPrimary": true,
      "verifiedAddress": true
    }
  ],
  "consents": [],
  "preferences": {"language": "en", "nickname": "ReadTest"}
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
